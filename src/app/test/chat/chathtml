  <!-- Chat Area -->
   
  <div class="chat-area">
    <!-- Messages -->
    <div class="messages" #messageContainer>
      <!-- Broadcast Messages -->
      <div *ngIf="activeTab === 'broadcast'">
        <div *ngFor="let msg of broadcastMessages" class="message">
          <div class="message-header">
            <strong>{{msg.fromUserName}}</strong>
            <small>{{msg.timestamp | date:'HH:mm'}}</small>
          </div>
          <div class="message-body">{{msg.message}}</div>
        </div>
      </div>
      
      <!-- Private Messages -->
      <div *ngIf="activeTab === 'private' && selectedUser">
        <div *ngFor="let msg of getPrivateMessagesForUser(selectedUser)" 
             class="message" 
             [class.own-message]="msg.fromUserId === currentUserId">
          <div class="message-header">
            <strong>{{msg.fromUserName}}</strong>
            <small>{{msg.timestamp | date:'HH:mm'}}</small>
          </div>
          <div class="message-body">{{msg.message}}</div>
        </div>
      </div>
      
      <!-- Group Messages -->
      <div *ngIf="activeTab === 'group' && currentGroup">
        <div *ngFor="let msg of groupMessages.get(currentGroup)" 
             class="message" 
             [class.own-message]="msg.fromUserId === currentUserId">
          <div class="message-header">
            <strong>{{msg.fromUserName}}</strong>
            <small>{{msg.timestamp | date:'HH:mm'}}</small>
          </div>
          <div class="message-body">{{msg.message}}</div>
        </div>
      </div>
    </div>
    
